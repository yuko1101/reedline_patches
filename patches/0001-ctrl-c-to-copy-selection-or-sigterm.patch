From 28c72d08ef5dcb2b00e5bb62c53f2f00ff42a729 Mon Sep 17 00:00:00 2001
From: yuko1101 <68993883+yuko1101@users.noreply.github.com>
Date: Wed, 22 Apr 2026 00:05:32 +0900
Subject: [PATCH] ctrl+c to copy selection or sigterm
X-Git-Patcher-Author: yuko1101 <68993883+yuko1101@users.noreply.github.com> 1776783932 +0900
X-Git-Patcher-Committer: yuko1101 <68993883+yuko1101@users.noreply.github.com> 1776783932 +0900
X-Git-Patcher-Commit-Message: Y3RybCtjIHRvIGNvcHkgc2VsZWN0aW9uIG9yIHNpZ3Rlcm0K
X-Git-Patcher-Parent-Hash: 9711eac88af66f445481618af6757d0acf31d700
X-Git-Patcher-Commit-Hash: 28c72d08ef5dcb2b00e5bb62c53f2f00ff42a729


---
 src/engine.rs | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/engine.rs b/src/engine.rs
index 66d04a2..8f8d781 100644
--- a/src/engine.rs
+++ b/src/engine.rs
@@ -1370,6 +1370,18 @@ impl Reedline {
                 }
             }
             ReedlineEvent::CtrlC => {
+                if self
+                    .editor
+                    .get_selection()
+                    .is_some_and(|(start, end)| start < end)
+                {
+                    #[cfg(feature = "system_clipboard")]
+                    self.editor
+                        .run_edit_command(&EditCommand::CopySelectionSystem);
+                    #[cfg(not(feature = "system_clipboard"))]
+                    self.editor.run_edit_command(&EditCommand::CopySelection);
+                    return Ok(EventStatus::Handled);
+                }
                 self.input_mode = InputMode::Regular;
                 Ok(EventStatus::Exits(Signal::CtrlC))
             }
@@ -1619,6 +1631,18 @@ impl Reedline {
                 }
             }
             ReedlineEvent::CtrlC => {
+                if self
+                    .editor
+                    .get_selection()
+                    .is_some_and(|(start, end)| start < end)
+                {
+                    #[cfg(feature = "system_clipboard")]
+                    self.editor
+                        .run_edit_command(&EditCommand::CopySelectionSystem);
+                    #[cfg(not(feature = "system_clipboard"))]
+                    self.editor.run_edit_command(&EditCommand::CopySelection);
+                    return Ok(EventStatus::Handled);
+                }
                 self.deactivate_menus();
                 self.run_edit_commands(&[EditCommand::Clear]);
                 self.editor.reset_undo_stack();
