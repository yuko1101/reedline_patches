X-Git-Patcher-Committer: yuko1101 <68993883+yuko1101@users.noreply.github.com> 1776784083 +0900
X-Git-Patcher-Commit-Message: ZGVsZXRlIHdvcmQK
X-Git-Patcher-Parent-Hash: 277fd9d40695236794f53ca078c1b57e300b426a
X-Git-Patcher-Commit-Hash: 29204656e0da6e11857f88177348a43a3a481651


---
 src/core_editor/editor.rs | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/core_editor/editor.rs b/src/core_editor/editor.rs
index 0d7673b..3600d6f 100644
--- a/src/core_editor/editor.rs
+++ b/src/core_editor/editor.rs
@@ -88,8 +88,8 @@ impl Editor {
             EditCommand::Backspace => self.backspace(),
             EditCommand::Delete => self.delete(),
             EditCommand::CutChar => self.cut_char(),
-            EditCommand::BackspaceWord => self.line_buffer.delete_word_left(),
-            EditCommand::DeleteWord => self.line_buffer.delete_word_right(),
+            EditCommand::BackspaceWord => self.backspace_word(),
+            EditCommand::DeleteWord => self.delete_word(),
             EditCommand::Clear => self.line_buffer.clear(),
             EditCommand::ClearToLineEnd => self.line_buffer.clear_to_line_end(),
             EditCommand::CutCurrentLine => self.cut_current_line(),
@@ -735,6 +735,22 @@ impl Editor {
         }
     }
 
+    fn backspace_word(&mut self) {
+        if self.selection_anchor.is_some() {
+            self.delete_selection();
+        } else {
+            self.line_buffer.delete_word_left();
+        }
+    }
+
+    fn delete_word(&mut self) {
+        if self.selection_anchor.is_some() {
+            self.delete_selection();
+        } else {
+            self.line_buffer.delete_word_right();
+        }
+    }
+
     fn move_word_left(&mut self, select: bool) {
         self.move_to_position(self.line_buffer.word_left_index(), select);
     }
